FROM node:20-alpine

WORKDIR /app

# Install curl and docker-cli for container healthchecks and docker inspection
RUN apk add --no-cache curl procps docker-cli

# Copy package descriptors and install dependencies
COPY package*.json ./
RUN npm install --omit=dev

# Copy application code
COPY server.js ./
COPY src ./src
COPY index.html ./

ENV PORT=22222
ENV HOST=0.0.0.0
ENV NODE_ENV=production

EXPOSE 22222

CMD ["node", "server.js"]

